{
  "name": "shipment-proposals",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "electron": "electron .",
    "build": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "html-to-text": "^9.0.5",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "multer": "^2.0.2",
    "mysql2": "^3.14.3",
    "nodemailer": "^7.0.5",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "nodemon": "^3.1.10"
  },
  "description": "",
  "build": {
    "appId": "com.yourdomain.shipmentproposals",
    "productName": "Shipment proposals",
    "directories": {
      "output": "dist2"
    },
    "files": [
      "main.js",
      "server.js",
      "routes/**/*",
      "controllers/**/*",
      "node_modules/**/*",
      "middlewares/**/*",
      "public/**/*",
      "package.json",
      ".env"
    ],
    "extraResources": [
      {
        "from": "./server.js",
        "to": "app/server.js"
      },
      {
        "from": "./routes",
        "to": "app/routes"
      },
      {
        "from": "./controllers",
        "to": "app/controllers"
      },
      {
        "from": "./middlewares",
        "to": "app/middlewares"
      },
      {
        "from": "./public",
        "to": "app/public"
      },
      {
        "from": "./.env",
        "to": "app/.env"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    }
  }
}
